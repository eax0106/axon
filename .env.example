# Copy to .env (never committed) and fill in. The app boots with every key empty:
# a feature whose key is missing answers 503 provider_not_configured, and
# GET /admin/providers shows each provider as configured, missing_key or unhealthy.

# --- Local services (Docker Compose sets its own values for containers) ---
DATABASE_URL=postgresql+asyncpg://axon:axon@localhost:5432/axon
REDIS_URL=redis://localhost:6379/0

# --- Auth: signing key for login tokens, at least 32 random characters. Generate one with
#     uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
#     Empty = signup and login answer 503 auth_not_configured.
AXON_JWT_SECRET=

# --- Voice engine: its public https URL, which Vobiz calls back on (a cloudflared tunnel locally).
#     Empty = the engine answers calls with 503 provider_not_configured.
AXON_ENGINE_PUBLIC_URL=
# --- API: its public https URL, which Vobiz calls back on when a call ends (a tunnel locally).
AXON_API_PUBLIC_URL=
# Optional: folder with ambience sounds (office.wav, call_center.wav, restaurant.wav,
#     quiet_room.wav, retail_store.wav: mono 16 kHz). Not shipped; with no file there is no background sound.
# AXON_AMBIENCE_DIR=
# Optional: calls the whole platform carries at once; new calls wait while it is full.
# AXON_MAX_CONCURRENT_CALLS=100

# --- Prices and tax (business settings with launch defaults; the owner confirms them, see
#     docs/phases/b7.md). Rupees; one credit is one rupee. Prices include GST. ---
# AXON_RATE_VALUE_PER_MIN=3.5
# AXON_RATE_STANDARD_PER_MIN=5
# AXON_RATE_PREMIUM_PER_MIN=7
# AXON_AI_USE_FEE=0.2               # each use of AI help (builder, chat sandbox, voice preview, analysis)
# AXON_FREE_CREDITS=50              # once per new account
# AXON_NUMBER_MONTHLY_FEE=649
# AXON_NUMBER_SETUP_FEE=0
# AXON_EXTRA_CHANNEL_FEE=0          # per extra channel per month
# AXON_NUMBER_GRACE_DAYS=7
# AXON_LOW_BALANCE=50               # warn (bell, chip, one email a day) below this
# AXON_TOPUP_MIN=100
# AXON_TOPUP_MAX=100000
# AXON_GST_RATE=18                  # percent, included in the price
# AXON_GST_SAC=                     # service accounting code, from your tax advisor
# AXON_SELLER_NAME=                 # your legal name, GSTIN, address and two-digit GST state code
# AXON_SELLER_GSTIN=
# AXON_SELLER_ADDRESS=
# AXON_SELLER_STATE_CODE=
# AXON_INVOICE_PREFIX=AXN

# --- Tests only: a Postgres server whose user may create databases (each test run makes its own),
#     and a Redis for the live-event tests.
# AXON_TEST_DATABASE_URL=postgresql+asyncpg://axon:axon@localhost:5432/postgres
# AXON_TEST_REDIS_URL=redis://localhost:6379/5

# --- Provider selection (optional; default is the first vendor of each kind) ---
# AXON_TELEPHONY_PROVIDER=vobiz
# AXON_STT_PROVIDER=sarvam          # sarvam | smallest
# AXON_LLM_PROVIDER=gemini          # gemini | sarvam
# AXON_EMBEDDING_PROVIDER=gemini
# AXON_TTS_PROVIDER=sarvam          # sarvam | smallest | cartesia
# AXON_PAYMENTS_PROVIDER=razorpay
# AXON_STORAGE_PROVIDER=r2
# AXON_WHATSAPP_PROVIDER=interakt   # interakt | aisensy
# AXON_CALENDAR_PROVIDER=google
# AXON_SHEETS_PROVIDER=google
# AXON_LEADS_PROVIDER=meta_lead_ads
# AXON_EMAIL_PROVIDER=resend
# AXON_NUMBER_KYC_PROVIDER=vobiz

# --- Vobiz (telephony, number KYC): Vobiz console > API credentials ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=

# --- Sarvam (STT Saaras, TTS Bulbul, optional LLM): dashboard.sarvam.ai > API keys ---
SARVAM_API_KEY=

# --- Google Gemini (LLM): aistudio.google.com > Get API key ---
GEMINI_API_KEY=
# Optional: Gemini model id (default gemini-2.5-flash; Google limits 2.5 to keys that used it before)
# AXON_GEMINI_MODEL=
# Optional: Gemini embedding model id for documents (default gemini-embedding-001)
# AXON_GEMINI_EMBEDDING_MODEL=

# --- Smallest (Standard voices, backup STT): smallest.ai console > API keys ---
SMALLEST_API_KEY=

# --- Cartesia (Premium voices): play.cartesia.ai > API keys ---
CARTESIA_API_KEY=
# Cartesia voice ids from play.cartesia.ai/voices. Hindi and Telugu have no default and answer 503 until set.
# CARTESIA_VOICE_HI=
# CARTESIA_VOICE_TE=
# CARTESIA_VOICE_EN=

# --- Resend (email: low-balance and renewal notices): resend.com > API keys; EMAIL_FROM is an address on a
#     domain verified there, for example "Axon <billing@yourdomain.in>" ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Razorpay (credit top-ups): dashboard.razorpay.com > Account & Settings > API keys / Webhooks ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Object storage, S3-compatible (Cloudflare R2): Cloudflare dashboard > R2 > Manage API tokens ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- WhatsApp BSP: Interakt > Developer settings, or AiSensy > API keys ---
INTERAKT_API_KEY=
AISENSY_API_KEY=

# --- Google Calendar + Sheets: console.cloud.google.com > APIs & Services > Credentials (OAuth client) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Meta Lead Ads webhook: developers.facebook.com > your app > Settings / Webhooks ---
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
